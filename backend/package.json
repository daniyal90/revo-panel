{
  "name": "lamix-sms-backend",
  "version": "1.0.0",
  "description": "LAMIX SMS Command Center Backend",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "prisma:generate": "prisma generate --schema ../database/schema.prisma",
    "prisma:migrate": "prisma migrate dev --schema ../database/schema.prisma",
    "prisma:studio": "prisma studio --schema ../database/schema.prisma",
    "prisma:validate": "prisma validate --schema ../database/schema.prisma",
    "lint": "eslint src --ext .ts",
    "type-check": "tsc --noEmit",
    "test": "node --import tsx --test src/**/*.test.ts"
  },
  "prisma": {
    "schema": "../database/schema.prisma"
  },
  "dependencies": {
    "@prisma/client": "^5.7.0",
    "bcryptjs": "^2.4.3",
    "bullmq": "^5.1.0",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "express-validator": "^7.0.1",
    "helmet": "^7.1.0",
    "ioredis": "^5.3.2",
    "jsonwebtoken": "^9.0.2",
    "smpp": "^0.6.0-rc.4",
    "socket.io": "^4.6.0",
    "winston": "^3.11.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/node": "^20.10.5",
    "@typescript-eslint/eslint-plugin": "^6.15.0",
    "@typescript-eslint/parser": "^6.15.0",
    "eslint": "^8.56.0",
    "prisma": "^5.7.0",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3"
  }
}
