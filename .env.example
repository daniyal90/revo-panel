# Lamix operating mode: production | demo (use DEMO_MODE for UI demo without production flag)
LAMIX_MODE=production
DEMO_MODE=false

# Database
DATABASE_URL="postgresql://user:password@localhost:5432/lamix_sms"
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10

# Redis (required for BullMQ outbound queue)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# JWT
JWT_SECRET=your-jwt-secret-key-min-32-characters
JWT_EXPIRES_IN=7d

# Server
PORT=3000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# Lamix SMPP (set official values from your Lamix account — do not guess)
LAMIX_SMPP_HOST=
LAMIX_SMPP_PORT=
LAMIX_SMPP_SYSTEM_ID=
LAMIX_SMPP_PASSWORD=
LAMIX_SMPP_SYSTEM_TYPE=
LAMIX_SMPP_SOURCE_TON=0
LAMIX_SMPP_SOURCE_NPI=1
LAMIX_SMPP_DEST_TON=1
LAMIX_SMPP_DEST_NPI=1
LAMIX_SMPP_TLS=true

# Lamix HTTP (optional — confirm official API URL and payload with Lamix)
LAMIX_HTTP_URL=
LAMIX_HTTP_TOKEN=

# Transport preference when both are configured: smpp | http
LAMIX_SMS_TRANSPORT=smpp
LAMIX_DEFAULT_SENDER=

# Queue / rate limits
SMS_QUEUE_CONCURRENCY=5
SMS_QUEUE_MAX_ATTEMPTS=5
SMS_QUEUE_BACKOFF_MS=2000
SMS_RATE_LIMIT_MAX=30
SMS_RATE_LIMIT_DURATION_MS=1000

# SMPP connection tuning
LAMIX_SMPP_BIND_TIMEOUT_MS=30000
LAMIX_SMPP_CONNECT_TIMEOUT_MS=30000
LAMIX_SMPP_ENQUIRE_LINK_MS=60000
LAMIX_SMPP_RECONNECT_BASE_MS=5000
LAMIX_SMPP_RECONNECT_MAX_MS=60000

# Rate Limiting (HTTP API)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Logging
LOG_LEVEL=info
LOG_FILE_PATH=logs

# Encryption (for future encrypted settings storage)
ENCRYPTION_KEY=change-this-to-a-32-byte-secret-key!!
