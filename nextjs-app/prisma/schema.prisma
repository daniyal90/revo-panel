// Prisma schema for real data NumberRange engine and traffic accounting
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id             String          @id @default(uuid())
  email          String          @unique
  name           String?
  passwordHash   String
  role           UserRole        @default(USER)
  isActive       Boolean         @default(true)
  lastLoginAt    DateTime?
  apiKey         String?         @unique
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  trafficLogs    TrafficLog[]
  payoutRequests PayoutRequest[]
  numberRanges   NumberRange[]
}

enum UserRole {
  ADMIN
  USER
}

enum UserStatus {
  PENDING
  APPROVED
  REJECTED
}

model NumberRange {
  id           String       @id @default(uuid())
  destination  String
  carrierCode  String
  prefix       String
  userId       String?
  user         User?        @relation(fields: [userId], references: [id])
  rate         Decimal      @db.Decimal(10, 6)
  status       RangeStatus  @default(LIVE)
  smppHost     String?
  smppPort     Int?
  smppSystemId String?
  smppPassword String?
  webhookUrl   String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  trafficLogs  TrafficLog[]

  @@index([destination])
  @@index([carrierCode])
  @@index([prefix])
}

enum RangeStatus {
  LIVE
  MAINTENANCE
  DEGRADED
  DISABLED
}

model TrafficLog {
  id           String        @id @default(uuid())
  user         User          @relation(fields: [userId], references: [id])
  userId       String
  range        NumberRange   @relation(fields: [rangeId], references: [id])
  rangeId      String
  destination  String
  messageId    String?
  status       MessageStatus
  deliveredAt  DateTime?
  payoutAmount Decimal       @db.Decimal(12, 6)
  createdAt    DateTime      @default(now())

  @@index([userId])
  @@index([rangeId])
  @@index([createdAt])
}

enum MessageStatus {
  PENDING
  DELIVERED
  FAILED
}

model PayoutRequest {
  id          String       @id @default(uuid())
  user        User         @relation(fields: [userId], references: [id])
  userId      String
  amount      Decimal      @db.Decimal(12, 6)
  method      PayoutMethod
  details     Json?
  status      PayoutStatus @default(PENDING)
  createdAt   DateTime     @default(now())
  processedAt DateTime?

  @@index([userId])
  @@index([status])
}

enum PayoutMethod {
  USDT_TRC20
  LITECOIN
  BANK_WIRE
  WISE
}

enum PayoutStatus {
  PENDING
  APPROVED
  REJECTED
  SENT
}

model SystemSetting {
  id        String   @id @default(uuid())
  key       String   @unique
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
